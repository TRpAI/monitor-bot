# Telegram Bot 核心凭证（从 @BotFather 获取）
TG_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_CHAT_ID=YOUR_ADMIN_CHAT_ID_NUMBER

# 巡检与并发参数
CHECK_INTERVAL=300          # 巡检间隔（秒），默认 5 分钟
MAX_FAILURES=2              # 连续失败次数触发告警阈值
CONCURRENT_LIMIT=10         # 最大并发探测数
MAX_RETENTION_DAYS=31       # 数据库历史保留天数

# Redis 缓冲队列连接（可选，留空则跳过 Redis，直接写 SQLite）
REDIS_URL=redis://127.0.0.1:6379/0
