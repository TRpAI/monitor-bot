[Unit]
Description=Industrial Distributed Telegram Monitor Bot
Documentation=https://qwenpaw.agentscope.io
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/monitor_bot
ExecStart=/opt/monitor_bot/venv/bin/python3 monitor_bot_optimized.py
Restart=always
RestartSec=5
LimitNOFILE=65535
Environment="PYTHONUNBUFFERED=1"

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/monitor_bot

[Install]
WantedBy=multi-user.target
